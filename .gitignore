# ===== 构建产物 =====
.xmake/
build/
Build/
/Bin/
logs/

# ===== IDE / 工具 =====
.zed/
.vscode/
.idea/
*.swp
*.swo
*~
.codegraph/
.playwright-mcp/

# ===== Python =====
__pycache__/
*.pyc

# ===== 自动生成代码 =====
**/Generated/
!**/Generated/.gitignore
**/AutoGen/*.gen.h
**/AutoGen/*.gen.cpp
!**/AutoGen/.gitignore
# protoc 生成的 C++ 代码（由 Proto/xmake.lua 在构建时生成）
**/AutoGen/*.pb.h
**/AutoGen/*.pb.cc

# ===== 测试残留 =====
test_compiler_tmp/

# ===== 三方库（源码 vendoring，按需选择性提交） =====
# 如果选择 git submodule 管理 ThirdParty/，则取消下面的注释
# ThirdParty/*/
# !ThirdParty/.gitignore

# ===== ThirdParty 构建中间文件 =====
ThirdParty/Build/

# openssl + libpq 二进制是手动管理并提交的（Windows vendored）
# protobuf + dasScript 由 BuildThirdParty.py 生成，暂不提交
ThirdParty/Bin/protobuf/
ThirdParty/Bin/dasScript/
ThirdParty/Bin/*/
!ThirdParty/Bin/openssl/
!ThirdParty/Bin/libpq/

# ===== 密钥（开发本地使用，不提交） =====
Config/login.key

# ===== 运行时 =====
*.log
core.*
*.dmp
